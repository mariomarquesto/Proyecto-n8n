    },
    {
      "parameters": {
        "jsCode": "const prev = $node[\"💾 Guardar ID\"].json;\nconst attempts = (prev.attempts || 0) + 1;\n\nif (attempts < 15) {\n  return [{\n    json: {\n      renderId: prev.renderId,\n      consejo: prev.consejo,\n      rowNumber: prev.rowNumber,\n      telefono: prev.telefono,\n      attempts: attempts\n    }\n  }];\n} else {\n  return [{\n    json: {\n      renderId: prev.renderId,\n      consejo: prev.consejo,\n      rowNumber: prev.rowNumber,\n      telefono: prev.telefono,\n      status: \"failed\",\n      error: \"Timeout\"\n    }\n  }];\n}"
      },
