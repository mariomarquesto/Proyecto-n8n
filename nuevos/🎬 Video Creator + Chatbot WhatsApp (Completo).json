    {
      "parameters": {
        "jsCode": "// Verificar si el video está listo\nconst status = $input.first().json.status;\nconst videoUrl = $input.first().json.url;\nconst snapshotUrl = $input.first().json.snapshot_url;\nconst renderId = $input.first().json.id;\n\n// Si está succeeded, pasamos los datos\nif (status === \"succeeded\") {\n  return [{\n    json: {\n      renderId: renderId,\n      videoUrl: videoUrl,\n      snapshotUrl: snapshotUrl,\n      status: \"succeeded\"\n    }\n  }];\n} \n// Si está rendering, reintentamos\nelse if (status === \"rendering\") {\n  // Lanzamos un error controlado para que n8n reintente\n  throw new Error(`Video aún en proceso (rendering). Reintentando...`);\n}\n// Si falló o cualquier otro estado\nelse {\n  return [{\n    json: {\n      renderId: renderId,\n      status: \"failed\",\n      error: `Estado inesperado: ${status}`\n    }\n  }];\n}"
      },
      "id": "7f069221-72f9-4867-81d5-66a68c5dab02",
      "name": "📦 Actualizar datos",
