        "jsCode": "// Extraer datos de la fila\nconst item = $input.first().json;\nconst consejo = item[\"A (Consejo)\"] || \"Aprende algo nuevo\";\nconst rowNumber = item.row_number;\nconst telefono = item[\"B (Telefono)\"] || \"\";\nconst estado = item[\"E (Estado)\"] || \"\";\n\nreturn [{\n  json: {\n    consejo: consejo,\n    rowNumber: rowNumber,\n    telefono: telefono,\n    estado: estado,\n    status: \"pending\"\n  }\n}];"
